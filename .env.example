# ============================================================
# PayPause - Shared Backend Environment
# Copy this file to .env and fill in the required credentials.
# ============================================================

# Core application
APP_NAME=PayPause API
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30

# Bhuvan modules
APP_ENV=development

# Flagsmith server-side environment key
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/
FLAGSMITH_REQUEST_TIMEOUT_SECONDS=3

# Development fallback identity only.
# Do not use this fallback as production authentication.
DEV_DEFAULT_USER_ID=usr_dev_bhuvan_001
DEV_DEFAULT_USER_EMAIL=bhuvan.developer@paypause.local
