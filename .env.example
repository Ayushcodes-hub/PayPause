# PayPause - Bhuvan Independent Backend Environment Configuration
# Copy this file to .env for local development

APP_ENV=development
DEBUG=true

# Flagsmith Server-side Environment Key
# Get this from your Flagsmith project -> Settings -> API Keys (Server-side SDK Key)
FLAGSMITH_ENVIRONMENT_KEY=

# Optional: Custom Flagsmith API URL (defaults to Flagsmith Edge API)
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/

# Development Authentication Defaults
DEV_DEFAULT_USER_ID=usr_dev_bhuvan_001
DEV_DEFAULT_USER_EMAIL=bhuvan.developer@paypause.local
